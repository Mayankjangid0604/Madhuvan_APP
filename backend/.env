PORT=5001
JWT_SECRET=super_secret_admin_key
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Email/SMS/WhatsApp providers (Gmail, MSG91, SMTP, Twilio, Meta, Custom) are
# configured from Settings -> Communication in the app (stored encrypted in
# the database), not from environment variables here.
#
# ENCRYPTION_KEY (optional): key used to encrypt provider secrets at rest.
# Falls back to JWT_SECRET if unset - set a dedicated one in production.
# ENCRYPTION_KEY=

# Google Drive Configuration
GOOGLE_DRIVE_FOLDER_ID=your_folder_id
